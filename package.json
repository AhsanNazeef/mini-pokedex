    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "echarts": "^6.1.0",
    "ngx-echarts": "^21.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "21.3.0",
    "eslint": "^10.0.2",
    "husky": "^8.0.3",
    "jsdom": "^28.0.0",
